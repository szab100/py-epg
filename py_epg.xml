<?xml version="1.0"?>
<settings>
  <filename>epg_porthu.xml</filename>
  <cache file="epg_cache.sqlite" enabled="true"
         channel-ttl="604800" program-ttl="2592000"/>

  <!-- Cache TTLs (seconds):
         channel-ttl  channel data (logo); default 604800 = 7 days
         program-ttl  program detail data; default 2592000 = 30 days
         meta-ttl     external metadata lookups; default 7776000 = 90 days
         listing-ttl  daily programme listings; default 21600 = 6 hours
                      (kept short so schedule changes propagate; an
                      interrupted run still resumes almost instantly)
  -->

  <!-- Optional: programme artwork enrichment (takes priority over the
       site's own images when a confident match is found; falls back to
       the site image otherwise). Lookups are cached under the 'meta'
       category (cache meta-ttl, default 90 days), negative results too.
       Attributes:
         provider       comma-separated providers, tried in order:
                        'tmdb'   (The Movie Database - needs tmdb_api_key)
                        'porthu' (port.hu - best coverage for Hungarian shows,
                                 undocumented internal endpoint, may break)
         {name}_{opt}   provider-specific options, e.g. tmdb_api_key =
                        free developer key from themoviedb.org
                        (Settings -> API -> Request API Key)
       Lookups run on the same worker pool as scraping (deduplicated
       across channels) - parallelism follows <pool-size>.
  -->
  <!--
  <metadata provider="tmdb,porthu" tmdb_api_key="YOUR_TMDB_API_KEY"/>
  -->
  <!-- or port.hu only, no API key needed:
  <metadata provider="porthu"/>
  -->

  <!-- Optional proxy config. Two forms:

       a) <proxy>http://host:port</proxy> - single static proxy
       b) <proxy-list> - rotating pool, applied to scraping AND metadata
          lookups (useful to route around per-IP bans). Bench state and
          list refreshes are shared across all workers through the
          cache DB - requires <cache> to be enabled for sharing and
          stats (proxy_stats table):
            url           remote newline-separated proxy list, refreshed
                          every 'refresh' seconds - any http(s) URL works,
                          e.g. a raw.githubusercontent.com .txt list
            proxy         inline entries (repeatable)
            refresh       list re-fetch interval, default 300s
            max-fails     failures before a proxy is benched (default 3)
            cooldown      bench time in seconds (default 600)
            timeout       per-request timeout via proxy (default 10s)
            tries         proxies attempted per request (default 3)
            allow-direct  fall back to direct if all proxies fail
                          (default true)
            per-proxy-delay  minimum seconds between uses of the same
                          proxy IP across ALL workers (default 0 = off);
                          rotation already spreads requests evenly, this
                          adds a hard per-IP floor for strict rate limits
       Accepted entry formats: host:port (assumed http),
       host:port:user:pass or user:pass@host:port for authenticated
       proxies, scheme://host:port (http,https,socks4,socks4a,socks5,
       socks5h), or CSV scheme,host,port[,user,pass].
       '#' lines are ignored.
  -->
  <!--
  <proxy-list url="https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt"
              refresh="900" max-fails="2" cooldown="300"/>
  -->

  <!-- leave empty to use randomly selected fake user_agent values -->
  <user-agent></user-agent>
  <!-- # of days to fetch programs for each channel -->
  <timespan>7</timespan>
  <pool-size>16</pool-size>
  <!-- Min seconds between HTTP requests *per worker process* during
       scraping (listings + programme details; metadata lookups have
       their own porthu_delay). Aggregate rate ~= pool-size/delay -
       e.g. 16 workers at 1.0s = ~16 req/s max. With a proxy pool the
       per-IP rate is divided further across proxies. Default: 0
       (port.hu falls back to its built-in 0.4s). -->
  <request-delay>1.0</request-delay>

  <!-- EPG source sites ('site' attribute per channel):
         tvmustra.hu - tvmustra.hu/tvmusor/<SITE_ID>; very fast, fewer icons
         m.musor.tv  - original musor.tv mobile site
         port.hu     - port.hu/tvapi; slower (detail page per programme) but
                       much richer: real stop times, posters, synopses,
                       cast/director, user rating, season/episode numbers.
                       SITE_ID is the port.hu channel id, e.g. tvchannel-5
                       for RTL - the full id/name list is available from
                       https://port.hu/tvapi/init-new. Programme details are
                       cached by content id (program:port.hu:movie-N /
                       episode-N), so repeat airings cost no extra requests.
       Sites can be mixed freely - this config uses port.hu where available
       and falls back to tvmustra.hu for channels port.hu doesn't carry.
       See py_epg_tvmustra.xml for the pure-tvmustra lineup.

       xmltv_id is the <channel id="..."> written to the output and the
       <programme channel="..."> reference; EPG consumers (e.g. Plex)
       remember channel mappings by this id. Keep it stable when moving
       a channel between sites or the client-side mapping breaks.
       The element text becomes the channel's display-name. -->

